<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileHeaderMotion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layoutDescription="@layout/profile_header_motion">

    <MotionScene>
        <Transition
            app:constraintSetStart="@+id/start"
            app:constraintSetEnd="@+id/end"
            app:duration="300"
            app:motionInterpolator="easeInOut" />

        <ConstraintSet android:id="@+id/start">
            <Constraint android:id="@id/avatarView">
                <Layout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent" />
            </Constraint>
            <Constraint android:id="@id/nameView">
                <Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/avatarView"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/avatarView"
                    app:layout_constraintEnd_toStartOf="@id/btnMessage" />
            </Constraint>
            <Constraint android:id="@id/statusView">
                <Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/nameView"
                    app:layout_constraintTop_toBottomOf="@id/nameView"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="@id/nameView" />
            </Constraint>
            <Constraint android:id="@id/btnMessage">
                <Layout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnCall"
                    android:layout_marginEnd="8dp" />
            </Constraint>
            <Constraint android:id="@id/btnCall">
                <Layout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp" />
            </Constraint>
        </ConstraintSet>

        <ConstraintSet android:id="@+id/end">
            <Constraint android:id="@id/avatarView">
                <Layout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="parent" />
            </Constraint>
            <Constraint android:id="@id/nameView">
                <Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/avatarView"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toBottomOf="@id/avatarView"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toStartOf="@id/btnMessage" />
            </Constraint>
            <Constraint android:id="@id/statusView">
                <Layout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/nameView"
                    app:layout_constraintTop_toBottomOf="@id/nameView"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toEndOf="@id/nameView" />
            </Constraint>
            <Constraint android:id="@id/btnMessage">
                <Layout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toBottomOf="@id/statusView"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toStartOf="@id/btnCall"
                    android:layout_marginEnd="8dp" />
            </Constraint>
            <Constraint android:id="@id/btnCall">
                <Layout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toBottomOf="@id/statusView"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp" />
            </Constraint>
        </ConstraintSet>
    </MotionScene>

    <!-- Header content -->
    <ImageView
        android:id="@+id/avatarView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/nameView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Имя пользователя"
        android:textColor="@color/profile_text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Статус"
        android:textColor="@color/profile_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMessage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:icon="@drawable/ic_message"
        android:iconTint="@color/button_text"
        android:backgroundTint="@color/button_bg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:icon="@drawable/ic_call"
        android:iconTint="@color/button_text"
        android:backgroundTint="@color/button_bg" />

</androidx.constraintlayout.motion.widget.MotionLayout> 